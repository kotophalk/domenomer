# Скопировать в .env рядом с server.py / docker-compose.yml и заполнить.
# Локально server.py читает .env сам; в Docker переменные передаёт compose.

# Ключ Ahrefs APIv3 — обязателен. Создать: Ahrefs → Account settings → API keys
#   https://docs.ahrefs.com/docs/api/reference/api-keys-creation-and-management
# Эндпоинт domain-rating-free бесплатный (0 API units), но без ключа отдаёт 401.
AHREFS_API_KEY=

# --- Ниже — только для сервера, значения по умолчанию разумные ---

# Порт на 127.0.0.1, куда смотрит reverse proxy. Для каждого инструмента свой:
# 8000 — slovostat, 8001 — itogoskaz, 8002 — domain-checker, 8003 — domenomer.
DOMENOMER_PORT=8003

# Лимит Ahrefs на ключ (запросов в минуту). Держится глобально на весь сервер.
UPSTREAM_RATE_PER_MIN=60

# Сколько секунд запрос ждёт слот в очереди к Ahrefs; дольше — 429 с Retry-After.
QUEUE_MAX_WAIT=30

# Одновременных запросов к /api/dr с одного IP (фронтенд держит 4).
PER_IP_CONCURRENCY=6

# Доменов за один прогон (фронтенд обрезает список; сообщается через /api/limits).
MAX_DOMAINS=200

# Кэш успешных ответов: секунд (сутки) и записей. 0 — выключить.
CACHE_TTL=86400
CACHE_MAX=50000

# Origin'ы, которым разрешено дёргать API из браузера (для сайтов экосистемы),
# через запятую. Пусто — CORS выключен. Например: https://delosvod.ru
CORS_ALLOW_ORIGIN=

# INFO — строка на запрос к API; WARNING — только сбои апстрима.
LOG_LEVEL=INFO

# Номер счётчика Яндекс.Метрики. Пусто — счётчик в HTML не подключается
# (локальный стенд, тесты, чужие копии).
METRIKA_ID=
